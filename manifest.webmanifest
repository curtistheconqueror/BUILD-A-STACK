{
  "name": "WiseWage",
  "short_name": "WiseWage",
  "description": "Clock in and watch your pay accrue in real time.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#05080f",
  "theme_color": "#05080f",
  "icons": [
    { "src": "./icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "./icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Punch In or Out",
      "short_name": "Punch",
      "description": "Clock in if you are out, clock out if you are in",
      "url": "./?widget=1&action=toggle",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Clock In",
      "short_name": "Clock In",
      "description": "Start tracking time",
      "url": "./?widget=1&action=clockin",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Clock Out",
      "short_name": "Clock Out",
      "description": "Stop tracking time",
      "url": "./?widget=1&action=clockout",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Widget",
      "short_name": "Widget",
      "description": "Compact widget view",
      "url": "./?widget=1",
      "icons": [{ "src": "./icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
